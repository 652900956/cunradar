# ============================================================
# CunRadar 环境变量配置
# 复制此文件为 .env 并填入实际值
# ============================================================

# DeepSeek API 配置（用于 AI 日报生成）
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Telegram Bot 配置（用于推送日报，可选）
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# GitHub Token（可选，用于提高 API 速率限制）
# 不配置也能用，但每小时只能请求 60 次
GITHUB_TOKEN=

# ─── 关注列表（可选） ──────────────────────────────────────
# 如果不想把关注列表放在 config.yaml 中提交到公开仓库，
# 可以通过此环境变量传入（JSON 格式），优先级高于 config.yaml。
#
# 格式示例：
# FOLLOW_CONFIG={"youtube":[{"name":"博主A","channel_id":"UC..."}],"bilibili":[{"name":"UP主A","uid":123}],"rss":[{"name":"博客A","url":"https://..."}],"github":[{"name":"项目A","repo":"owner/repo"}],"github_trending":{"enabled":true,"language":"","limit":5}}
#
# FOLLOW_CONFIG=
