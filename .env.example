# ============================================================
# CunRadar 环境变量配置
# 复制此文件为 .env 并填入实际值：cp .env.example .env
# ============================================================

# ─── AI 配置（多供应商，OpenAI 兼容） ───────────────────────
# 选择供应商：deepseek / zhipu / hunyuan / qwen
#   deepseek : DeepSeek（付费）        key 形如 sk-xxx
#   zhipu    : 智谱 GLM-4.7-Flash（免费） key 形如 xxxx.xxxx
#   hunyuan  : 腾讯混元 Lite（免费）     key 为腾讯云 SecretId/SecretKey 合并或 API Key
#   qwen     : 通义千问（便宜）          key 形如 sk-xxx（DashScope / 阿里云百炼）
AI_PROVIDER=deepseek
# 对应供应商的 API Key（必填，否则跳过 AI 摘要）
AI_API_KEY=your_api_key_here
# 可选：覆盖模型名与接口地址（不填则用供应商预设）
AI_MODEL=
AI_BASE_URL=

# ─── 飞书推送（自定义机器人 Webhook） ──────────────────────
# 飞书群 → 设置 → 群机器人 → 添加机器人，复制 Webhook 地址
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxx
# 可选：在机器人「安全设置」里开启了「签名校验」才需要填
FEISHU_SECRET=

# ─── 企业微信推送（群机器人 Webhook，可选） ────────────────
# 企业微信群 → 群机器人 → 添加机器人，复制 Webhook 地址（留空则不推送）
WECOM_WEBHOOK_URL=

# ─── 钉钉推送（自定义机器人 Webhook，可选） ────────────────
# 钉钉群 → 智能群助手 → 添加机器人，复制 Webhook 地址（留空则不推送）
DINGTALK_WEBHOOK_URL=
# 可选：机器人「安全设置」选择「加签」时填写的 secret
DINGTALK_SECRET=

# ─── GitHub Token（可选） ──────────────────────────────────
# 不配置也能用，但每小时只能请求 60 次；配置后额度大幅提升
GITHUB_TOKEN=

# ─── 关注列表（可选） ──────────────────────────────────────
# 如果不想把关注列表放在 config.yaml 中提交到公开仓库，
# 可以通过此环境变量传入（JSON 格式），优先级高于 config.yaml。
#
# 格式示例（跑通流程用，可自行修改）：
# FOLLOW_CONFIG={"youtube":[{"name":"Web3村长","channel_id":"UC5MbekhrH8iyFBQLbccBSRg"}],"bilibili":[{"name":"Web3村长Official","uid":1224034462}],"rss":[{"name":"村长博客","url":"https://cunzhangblog.com/rss.xml"}],"github":[{"name":"CunRadar","repo":"652900956/CunRadar"}],"github_trending":{"enabled":true,"language":"","limit":5}}
#
# FOLLOW_CONFIG=
